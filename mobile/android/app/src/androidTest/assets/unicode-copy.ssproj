 "pageEighths": 2, "status": "todo", "notes": "", "tagIds": ["tag-14sdq2t", "tag-j1hgp1", "tag-1azzvga"]}], "tags": [{"id": "tag-ccsnet", "sceneId": "s1", "category": "location", "name": "便利店", "sourceElementId": "s1", "sourceText": "内景 便利店 - 夜", "confirmed": false, "notes": ""}, {"id": "tag-1lgxcwi", "sceneId": "s1", "category": "cast", "name": "林夏", "sourceElementId": "c3", "sourceText": "林夏", "confirmed": false, "notes": ""}, {"id": "tag-qd5lh9", "sceneId": "s1", "category": "cast", "name": "阿城", "sourceElementId": "c2", "sourceText": "阿城", "confirmed": false, "notes": ""}, {"id": "tag-214a43", "sceneId": "s2", "category": "location", "name": "便利店门口", "sourceElementId": "s2", "sourceText": "外景 便利店门口 - 夜", "confirmed": false, "notes": ""}, {"id": "tag-11mjbts", "sceneId": "s2", "category": "cast", "name": "阿城", "sourceElementId": "c7", "sourceText": "阿城", "confirmed": false, "notes": ""}, {"id": "tag-n8vbej", "sceneId": "s2", "category": "cast", "name": "林夏", "sourceElementId": "c6", "sourceText": "林夏", "confirmed": false, "notes": ""}, {"id": "tag-w1bn4j", "sceneId": "s3", "category": "location", "name": "便利店", "sourceElementId": "s3", "sourceText": "内景 便利店 - 夜", "confirmed": false, "notes": ""}, {"id": "tag-17c8pak", "sceneId": "s3", "category": "cast", "name": "林夏", "sourceElementId": "c10", "sourceText": "林夏", "confirmed": false, "notes": ""}, {"id": "tag-163rdt3", "sceneId": "s3", "category": "cast", "name": "阿城", "sourceElementId": "c9", "sourceText": "阿城", "confirmed": false, "notes": ""}, {"id": "tag-14sdq2t", "sceneId": "s4", "category": "location", "name": "便利店门口", "sourceElementId": "s4", "sourceText": "外景 便利店门口 - 夜", "confirmed": false, "notes": ""}, {"id": "tag-j1hgp1", "sceneId": "s4", "category": "cast", "name": "林夏", "sourceElementId": "c11", "sourceText": "林夏", "confirmed": false, "notes": ""}, {"id": "tag-1azzvga", "sceneId": "s4", "category": "cast", "name": "阿城", "sourceElementId": "c12", "sourceText": "阿城", "confirmed": false, "notes": ""}], "locations": [], "shots": [], "takes": [], "assets": [], "shootDays": [], "tasks": [], "notes": [], "changeImpacts": [], "revisionSets": [], "revisionDistributions": [], "castAvailability": [], "travelTimes": [], "budgetLines": [], "assetEvents": []}}